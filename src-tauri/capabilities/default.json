{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the settings, picker and screenshot overlay webviews",
  "windows": ["settings", "picker", "capture-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "dialog:default",
    "clipboard-manager:default",
    "opener:default"
  ]
}
