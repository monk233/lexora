{
  "name": "lexora",
  "version": "0.4.0",
  "private": true,
  "description": "Lexora — 轻量划词翻译工具：选中任意文本即可翻译、总结、解释、朗读；支持在线 OpenAI 兼容 API 与本地 GGUF 离线模型。",
  "license": "MIT",
  "author": "Lexora contributors",
  "homepage": "https://github.com/monk233/lexora",
  "repository": {
    "type": "git",
    "url": "https://github.com/monk233/lexora.git"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "build:debug": "tauri build --debug --no-bundle",
    "fetch:llama": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-llama.ps1",
    "icons:skills": "node scripts/make_skill_icons.mjs",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
